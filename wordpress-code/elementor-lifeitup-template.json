: 12px !important;\n    font-weight: 800 !important;\n    background: #EBF5EE !important;\n    border: 1.5px solid #A7D7B5 !important;\n    color: #064E3B !important;\n  }\n\n  .liu-report-block {\n    text-align: left !important;\n    padding: 16px 18px !important;\n    border-radius: 12px !important;\n    margin-bottom: 14px !important;\n  }\n  .liu-block-highlight {\n    background: #F3F8F4 !important;\n    border-left: 4px solid #059669 !important;\n    border-top: 1px solid #E5DFD3 !important;\n    border-right: 1px solid #E5DFD3 !important;\n    border-bottom: 1px solid #E5DFD3 !important;\n  }\n  .liu-block-white {\n    background: #FFFFFF !important;\n    border: 1px solid #EBE5D8 !important;\n  }\n  .liu-block-title {\n    font-size: 14px !important;\n    font-weight: 800 !important;\n    color: #0A2618 !important;\n    margin: 0 0 6px 0 !important;\n  }\n  .liu-section-tag {\n    font-size: 11px !important;\n    font-weight: 900 !important;\n    color: #047857 !important;\n    letter-spacing: 0.08em !important;\n    text-transform: uppercase !important;\n    margin: 0 0 8px 0 !important;\n  }\n  .liu-block-p {\n    font-size: 13px !important;\n    line-height: 1.55 !important;\n    color: #1A2E24 !important;\n    margin: 0 !important;\n  }\n  .liu-block-muted {\n    font-size: 12px !important;\n    line-height: 1.5 !important;\n    color: #4A6354 !important;\n    font-style: italic !important;\n    margin: 6px 0 0 0 !important;\n  }\n  .liu-move-rule-text {\n    font-weight: 800 !important;\n    font-size: 14px !important;\n    color: #0A2618 !important;\n    margin: 0 0 4px 0 !important;\n  }\n  .liu-pathway-chain {\n    font-size: 15px !important;\n    font-weight: 900 !important;\n    letter-spacing: 0.04em !important;\n    color: #047857 !important;\n  }\n\n  .liu-dispatched-box {\n    display: flex !important;\n    align-items: center !important;\n    gap: 12px !important;\n    text-align: left !important;\n    background: #EBF5EE !important;\n    border: 1.5px solid #A7D7B5 !important;\n    padding: 14px 16px !important;\n    border-radius: 12px !important;\n    font-size: 12px !important;\n    color: #064E3B !important;\n    line-height: 1.5 !important;\n    margin-top: 18px !important;\n  }\n  .liu-dispatch-icon {\n    font-size: 24px !important;\n    flex-shrink: 0 !important;\n  }\n\n  /* Footer */\n  .liu-brand-footer {\n    text-align: center !important;\n    font-size: 11px !important;\n    color: #73887C !important;\n    margin-top: 30px !important;\n  }\n  .liu-brand-footer a {\n    color: #047857 !important;\n    text-decoration: underline !important;\n  }\n</style>\n\n<!-- =========================================================================\n     JAVASCRIPT LOGIC & API DISPATCH\n     ========================================================================= -->\n<script>\n(function() {\n  var API_ENDPOINT = \"https://lifeitup.vercel.app/api/leads\";\n\n  var questions = [\n    { id: 1, pillarId: \"soul\", pillarName: \"Pillar 1 — Soul / Purpose\", icon: \"🌟\", text: \"My daily life is connected to a clear, bigger purpose\" },\n    { id: 2, pillarId: \"soul\", pillarName: \"Pillar 1 — Soul / Purpose\", icon: \"🌟\", text: \"The way I spend my time reflects, what truly matters to me.\" },\n    { id: 3, pillarId: \"mind\", pillarName: \"Pillar 2 — Mind / Inner Calm\", icon: \"🧠\", text: \"I can stay calm and think clearly when life becomes stressful.\" },\n    { id: 4, pillarId: \"mind\", pillarName: \"Pillar 2 — Mind / Inner Calm\", icon: \"🧠\", text: \"I can focus on that matters, without constant distractions\" },\n    { id: 5, pillarId: \"body\", pillarName: \"Pillar 3 — Body / Energy\", icon: \"⚡\", text: \"I feel energetic throughout the day\" },\n    { id: 6, pillarId: \"body\", pillarName: \"Pillar 3 — Body / Energy\", icon: \"⚡\", text: \"My everyday habits—sleep, movement, food - nutrition & recovery are in ideal zone.\" },\n    { id: 7, pillarId: \"career\", pillarName: \"Pillar 4 — Career / Growth\", icon: \"🚀\", text: \"I have clarity & confidence in making important career decisions\" },\n    { id: 8, pillarId: \"career\", pillarName: \"Pillar 4 — Career / Growth\", icon: \"🚀\", text: \"I feel that I am learning, moving, growing in an area that matters to me.\" },\n    { id: 9, pillarId: \"environment\", pillarName: \"Pillar 5 — Environment / Connection\", icon: \"🌿\", text: \"My physical and digital surroundings help me feel organised, calm and in control.\" },\n    { id: 10, pillarId: \"environment\", pillarName: \"Pillar 5 — Environment / Connection\", icon: \"🌿\", text: \"The people closest to me generally support my wellbeing, growth and sense of belonging.\" },\n    { id: 11, pillarId: \"contribution\", pillarName: \"Pillar 6 — Contribution / Impact\", icon: \"🤝\", text: \"I feel that what I do makes a positive difference to other people.\" },\n    { id: 12, pillarId: \"contribution\", pillarName: \"Pillar 6 — Contribution / Impact\", icon: \"🤝\", text: \"I regularly make time to help, support or uplift others.\" }\n  ];\n\n  var options = [\n    { label: \"Never\", value: 1 },\n    { label: \"Sometimes\", value: 2 },\n    { label: \"Often\", value: 3 },\n    { label: \"Always\", value: 4 }\n  ];\n\n  var currentIndex = 0;\n  var answers = {};\n  var sessionId = \"wp_res_\" + Math.random().toString(36).substring(2, 9) + \"_\" + Date.now();\n  var localScoreResult = null;\n\n  function showScreen(screenId) {\n    var screens = document.querySelectorAll(\"#lifeitup-app-root .liu-screen\");\n    for (var i = 0; i < screens.length; i++) {\n      screens[i].classList.remove(\"active\");\n    }\n    var target = document.getElementById(screenId);\n    if (target) {\n      target.classList.add(\"active\");\n    }\n    var root = document.getElementById(\"lifeitup-app-root\");\n    if (root) {\n      root.scrollIntoView({ behavior: \"smooth\", block: \"start\" });\n    }\n  }\n\n  function calculateScore(ans) {\n    var total = 0;\n    for (var i = 1; i <= 12; i++) {\n      total += Number(ans[i] || 2);\n    }\n    var zone = \"STABLE\";\n    var title = \"YOU'VE BUILT A FOUNDATION. WHAT'S HOLDING BACK YOUR NEXT LEVEL?\";\n    var emoji = \"🟢\";\n    var headline = \"Your responses suggest relatively positive alignment across several dimensions of life.\";\n    var reassurance = \"A good overall score can sometimes hide one neglected area. That is where your next breakthrough lies.\";\n    var firstMoveRule = \"Don't chase more. Identify what's missing.\";\n    var firstMoveAdvice = \"Look for the one pillar significantly below your strongest pillar.\";\n    var pathwaySteps = [\"REFINE\", \"STRENGTHEN\", \"SUSTAIN\"];\n    var pathwayDescription = \"Evidence-based refinement across your key dimensions.\";\n\n    if (total <= 20) {\n      zone = \"LOW\";\n      title = \"A RESET MAY BE NEEDED\";\n      emoji = \"🔴\";\n      headline = \"Your responses suggest that several areas of your life may currently be competing for your energy, attention and wellbeing.\";\n      reassurance = \"This doesn't mean something is wrong with you. Small adjustments create lasting change.\";\n      firstMoveRule = \"Don't try to change everything at once.\";\n      firstMoveAdvice = \"Identify your lowest-scoring pillar and choose one behaviour to improve for the next 7 days.\";\n      pathwaySteps = [\"RESET\", \"REBUILD\", \"REPEAT\"];\n      pathwayDescription = \"Prioritize your primary growth pillar and first actionable steps.\";\n    } else if (total <= 32) {\n      zone = \"MODERATE\";\n      title = \"YOU HAVE A FOUNDATION. NOW FIND THE GAP.\";\n      emoji = \"🟠\";\n      headline = \"Your responses suggest that some areas of life are working reasonably well, while others may be quietly limiting your energy, wellbeing or performance.\";\n      reassurance = \"This is often where small, consistent changes can create meaningful momentum.\";\n      firstMoveRule = \"Don't improve everything. Find the one pillar with the biggest gap.\";\n      firstMoveAdvice = \"Ask: “What one behaviour, if improved consistently, would make the biggest difference?”\";\n      pathwaySteps = [\"IDENTIFY\", \"FOCUS\", \"BUILD\"];\n      pathwayDescription = \"Your personalized report can reveal where your next improvement will have maximum value.\";\n    } else if (total <= 40) {\n      zone = \"STABLE\";\n      title = \"YOU'VE BUILT A FOUNDATION. WHAT'S HOLDING BACK YOUR NEXT LEVEL?\";\n      emoji = \"🟢\";\n    } else {\n      zone = \"BALANCED\";\n      title = \"YOUR FOUNDATION IS STRONG. NOW PROTECT IT.\";\n      emoji = \"🔵\";\n      headline = \"Your responses suggest consistent positive alignment across the six areas assessed.\";\n      reassurance = \"The real challenge is maintaining it when work intensifies and life becomes demanding.\";\n      firstMoveRule = \"Don't become complacent.\";\n      firstMoveAdvice = \"Ask: “What would make my life healthier and more sustainable?”\";\n      pathwaySteps = [\"SUSTAIN\", \"DEEPEN\", \"CONTRIBUTE\"];\n      pathwayDescription = \"Deepening resilience and long-term sustainable high performance.\";\n    }\n\n    return {\n      score: total,\n      zone: zone,\n      emoji: emoji,\n      title: title,\n      headline: headline,\n      reassurance: reassurance,\n      firstMoveRule: firstMoveRule,\n      firstMoveAdvice: firstMoveAdvice,\n      pathwaySteps: pathwaySteps,\n      pathwayDescription: pathwayDescription\n    };\n  }\n\n  window.liuStartAssessment = function() {\n    currentIndex = 0;\n    answers = {};\n    renderCurrentQuestion();\n    showScreen(\"liu-screen-quiz\");\n  };\n\n  function renderCurrentQuestion() {\n    var q = questions[currentIndex];\n    var currentStep = currentIndex + 1;\n    var pct = Math.round((currentStep / 12) * 100);\n\n    document.getElementById(\"liu-q-counter\").textContent = \"Question \" + currentStep + \" of 12\";\n    document.getElementById(\"liu-q-pct\").textContent = pct + \"% Complete\";\n    document.getElementById(\"liu-progress-bar\").style.width = pct + \"%\";\n\n    document.getElementById(\"liu-pillar-icon-symbol\").textContent = q.icon;\n    document.getElementById(\"liu-pillar-text\").textContent = q.pillarName;\n    document.getElementById(\"liu-question-text\").textContent = q.text;\n\n    var container = document.getElementById(\"liu-options-list\");\n    container.innerHTML = \"\";\n\n    var selectedVal = answers[q.id];\n\n    options.forEach(function(opt) {\n      var isSelected = selectedVal === opt.value;\n      var card = document.createElement(\"div\");\n      card.className = \"liu-royal-option\" + (isSelected ? \" selected\" : \"\");\n      card.onclick = function() {\n        answers[q.id] = opt.value;\n        renderCurrentQuestion();\n        document.getElementById(\"liu-btn-next\").disabled = false;\n      };\n\n      card.innerHTML = \n        '<div class=\"liu-opt-left\">' +\n          '<div class=\"liu-circle-indicator\">' +\n            '<svg class=\"liu-check-svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\"><polyline points=\"20 6 9 17 4 12\"></polyline></svg>' +\n          '</div>' +\n          '<span class=\"liu-opt-label\">' + opt.label + '</span>' +\n        '</div>';\n\n      container.appendChild(card);\n    });\n\n    document.getElementById(\"liu-btn-back\").style.visibility = (currentIndex === 0) ? \"hidden\" : \"visible\";\n    document.getElementById(\"liu-btn-next\").disabled = (selectedVal === undefined);\n    document.getElementById(\"liu-next-btn-text\").textContent = (currentIndex === 11) ? \"Complete Assessment\" : \"Next\";\n  }\n\n  window.liuPrevQuestion = function() {\n    if (currentIndex > 0) {\n      currentIndex--;\n      renderCurrentQuestion();\n    }\n  };\n\n  window.liuNextQuestion = function() {\n    if (answers[questions[currentIndex].id] === undefined) return;\n\n    if (currentIndex < 11) {\n      currentIndex++;\n      renderCurrentQuestion();\n    } else {\n      // 12th Question Answered -> Calculate Score & Go to Analyzing\n      localScoreResult = calculateScore(answers);\n      document.getElementById(\"liu-teaser-zone\").textContent = localScoreResult.zone;\n      document.getElementById(\"liu-teaser-score\").textContent = localScoreResult.score;\n      document.getElementById(\"liu-lead-desc-zone\").textContent = localScoreResult.zone;\n\n      showScreen(\"liu-screen-analyzing\");\n      setTimeout(function() {\n        showScreen(\"liu-screen-lead\");\n      }, 1300);\n    }\n  };\n\n  window.liuSubmitForm = async function(e) {\n    e.preventDefault();\n    var errBox = document.getElementById(\"liu-global-error\");\n    errBox.style.display = \"none\";\n\n    var name = document.getElementById(\"liu-input-name\").value.trim();\n    var institution = document.getElementById(\"liu-input-institution\").value.trim();\n    var phone = document.getElementById(\"liu-input-phone\").value.trim();\n    var email = document.getElementById(\"liu-input-email\").value.trim();\n    var consent = document.getElementById(\"liu-input-consent\").checked;\n\n    var valid = true;\n    function checkField(val, errId, msg) {\n      var el = document.getElementById(errId);\n      if (!val) {\n        el.textContent = msg;\n        el.classList.add(\"visible\");\n        valid = false;\n      } else {\n        el.textContent = \"\";\n        el.classList.remove(\"visible\");\n      }\n    }\n\n    checkField(name, \"liu-err-name\", \"Full Name is required (min 2 characters).\");\n    checkField(institution, \"liu-err-institution\", \"Institution / Organisation Name is required.\");\n    checkField(phone, \"liu-err-phone\", \"Valid 10-digit mobile number is required.\");\n    checkField(email, \"liu-err-email\", \"Valid email address is required.\");\n\n    if (!consent) {\n      document.getElementById(\"liu-err-consent\").textContent = \"Please agree to communication consent.\";\n      document.getElementById(\"liu-err-consent\").classList.add(\"visible\");\n      valid = false;\n    } else {\n      document.getElementById(\"liu-err-consent\").classList.remove(\"visible\");\n    }\n\n    if (!valid) return;\n\n    var submitBtn = document.getElementById(\"liu-btn-submit-lead\");\n    submitBtn.disabled = true;\n    submitBtn.innerHTML = \"<span>GENERATING YOUR REPORT...</span>\";\n\n    var payload = {\n      sessionId: sessionId,\n      fullName: name,\n      organization: institution,\n      institution: institution,\n      email: email,\n      mobile: phone,\n      consent: consent,\n      answers: answers\n    };\n\n    try {\n      var res = await fetch(API_ENDPOINT, {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify(payload)\n      });\n      var data = await res.json();\n\n      if (!res.ok) {\n        throw new Error(data.error || \"Failed to submit lead data.\");\n      }\n\n      // Display Final Report\n      renderFinalReport(data);\n      showScreen(\"liu-screen-report\");\n\n    } catch (err) {\n      console.warn(\"Backend API warning, rendering local score:\", err);\n      // Even if network blips, user gets their instant score report\n      renderFinalReport({ report: { score: localScoreResult.score, scoreBand: localScoreResult } });\n      showScreen(\"liu-screen-report\");\n    } finally {\n      submitBtn.disabled = false;\n      submitBtn.innerHTML = '<span>SEND ME MY OFFICIAL REPORT</span><svg class=\"liu-arrow-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line><polyline points=\"12 5 19 12 12 19\"></polyline></svg>';\n    }\n  };\n\n  function renderFinalReport(data) {\n    var report = data.report || {};\n    var band = report.scoreBand || localScoreResult || {};\n    var score = report.score || localScoreResult.score || 36;\n\n    document.getElementById(\"liu-report-score-num\").textContent = score;\n    document.getElementById(\"liu-report-zone-badge\").textContent = (band.emoji || \"✨\") + \" STATUS: \" + (band.zone || \"STABLE\");\n    document.getElementById(\"liu-report-band-title\").textContent = band.title || \"YOUR ASSESSMENT RESULT\";\n    document.getElementById(\"liu-report-band-headline\").textContent = band.headline || \"\";\n    document.getElementById(\"liu-report-band-reassurance\").textContent = band.reassurance || \"\";\n    document.getElementById(\"liu-report-move-rule\").textContent = band.firstMoveRule || \"\";\n    document.getElementById(\"liu-report-move-advice\").textContent = band.firstMoveAdvice || \"\";\n    document.getElementById(\"liu-report-pathway-steps\").innerHTML = (band.pathwaySteps || [\"RESET\", \"BUILD\", \"SUSTAIN\"]).join(\" &rarr; \");\n    document.getElementById(\"liu-report-pathway-desc\").textContent = band.pathwayDescription || \"\";\n  }\n\n  window.liuRestartAssessment = function() {\n    sessionId = \"wp_res_\" + Math.random().toString(36).substring(2, 9) + \"_\" + Date.now();\n    currentIndex = 0;\n    answers = {};\n    document.getElementById(\"liu-form-element\").reset();\n    showScreen(\"liu-screen-intro\");\n  };\n\n})();\n</script>\n"
              }
            }

            {
              "id": "liu_widget_ot26b3j",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "<!-- =========================================================================\n     LIFEITUP 2-MINUTE HOLISTIC WELLBEING CHECK — STANDALONE WORDPRESS CODE\n     Paste this entire code block into any WordPress Page (Custom HTML / Elementor HTML)\n     NO PLUGINS REQUIRED!\n     ========================================================================= -->\n\n<div id=\"lifeitup-wellness-app\">\n  <div class=\"liu-container\">\n    \n    <!-- 1. INTRO SCREEN -->\n    <div id=\"liu-step-intro\" class=\"liu-screen active\">\n      <div class=\"liu-badge\">EVIDENCE-BASED SELF REFLECTION</div>\n      <h1 class=\"liu-hero-title\">2-MINUTE LIFEITUP<br><span class=\"liu-highlight\">HOLISTIC WELLBEING CHECK</span></h1>\n      <p class=\"liu-hero-sub\">Get an evidence-based snapshot of your energy, focus, and life alignment — with a personalised action report sent to you instantly.</p>\n\n      <div class=\"liu-pillars-grid\">\n        <div class=\"liu-pillar-chip\">🌟 Soul / Purpose</div>\n        <div class=\"liu-pillar-chip\">🧠 Mind / Inner Calm</div>\n        <div class=\"liu-pillar-chip\">⚡ Body / Energy</div>\n        <div class=\"liu-pillar-chip\">🚀 Career / Growth</div>\n        <div class=\"liu-pillar-chip\">🌿 Environment / Connection</div>\n        <div class=\"liu-pillar-chip\">🤝 Contribution / Impact</div>\n      </div>\n\n      <div class=\"liu-btn-wrap\">\n        <button type=\"button\" class=\"liu-btn-primary\" onclick=\"liuStartQuiz()\">\n          START 2-MINUTE CHECK &rarr;\n        </button>\n      </div>\n    </div>\n\n    <!-- 2. QUIZ SCREEN -->\n    <div id=\"liu-step-quiz\" class=\"liu-screen\">\n      <div class=\"liu-quiz-header\">\n        <div class=\"liu-progress-meta\">\n          <span id=\"liu-q-counter\">Question 1 of 12</span>\n          <span id=\"liu-pillar-badge\" class=\"liu-mini-badge\">Pillar 1 — Soul / Purpose</span>\n        </div>\n        <div class=\"liu-progress-track\">\n          <div id=\"liu-progress-bar\" class=\"liu-progress-fill\" style=\"width: 8.33%;\"></div>\n        </div>\n      </div>\n\n      <div class=\"liu-question-box\">\n        <h2 id=\"liu-question-text\" class=\"liu-question-title\">My daily life is connected to a clear, bigger purpose.</h2>\n      </div>\n\n      <div class=\"liu-options-grid\" id=\"liu-options-container\">\n        <!-- Rendered via JS -->\n      </div>\n\n      <div class=\"liu-nav-row\">\n        <button type=\"button\" id=\"liu-btn-back\" class=\"liu-btn-outline\" onclick=\"liuPrevQuestion()\" style=\"visibility: hidden;\">\n          &larr; Back\n        </button>\n        <button type=\"button\" id=\"liu-btn-next\" class=\"liu-btn-primary\" onclick=\"liuNextQuestion()\" disabled>\n          Next &rarr;\n        </button>\n      </div>\n    </div>\n\n    <!-- 3. ANALYZING SCREEN -->\n    <div id=\"liu-step-analyzing\" class=\"liu-screen\">\n      <div class=\"liu-analyzing-box\">\n        <div class=\"liu-spinner\"></div>\n        <h2 class=\"liu-analyzing-title\">Analyzing Your 6 Wellbeing Dimensions...</h2>\n        <p class=\"liu-analyzing-desc\">Aligning responses with WHO multidimensional wellbeing guidelines.</p>\n      </div>\n    </div>\n\n    <!-- 4. LEAD CAPTURE SCREEN -->\n    <div id=\"liu-step-lead\" class=\"liu-screen\">\n      <div class=\"liu-lead-box\">\n        <div class=\"liu-badge\">ASSESSMENT COMPLETE</div>\n        <h2 class=\"liu-lead-title\">Where Should We Send Your Official Report?</h2>\n        <p class=\"liu-lead-sub\">Enter your details below to unlock your holistic score and receive your official PDF report instantly via Email & WhatsApp.</p>\n\n        <form id=\"liu-lead-form\" onsubmit=\"liuHandleFormSubmit(event)\">\n          <div class=\"liu-field-group\">\n            <label class=\"liu-label\">Full Name *</label>\n            <input type=\"text\" id=\"liu-name\" class=\"liu-input\" placeholder=\"e.g. Rahul Sharma\" required />\n          </div>\n\n          <div class=\"liu-field-group\">\n            <label class=\"liu-label\">Institution / College / Company Name</label>\n            <input type=\"text\" id=\"liu-institution\" class=\"liu-input\" placeholder=\"e.g. Delhi University / St. Xavier's\" />\n          </div>\n\n          <div class=\"liu-field-group\">\n            <label class=\"liu-label\">Mobile Number (WhatsApp) *</label>\n            <input type=\"tel\" id=\"liu-phone\" class=\"liu-input\" placeholder=\"e.g. +91 98765 43210\" required />\n          </div>\n\n          <div class=\"liu-field-group\">\n            <label class=\"liu-label\">Email Address *</label>\n            <input type=\"email\" id=\"liu-email\" class=\"liu-input\" placeholder=\"e.g. rahul@example.com\" required />\n          </div>\n\n          <div class=\"liu-checkbox-group\">\n            <label class=\"liu-checkbox-label\">\n              <input type=\"checkbox\" id=\"liu-consent\" class=\"liu-checkbox\" checked required />\n              <span>I consent to receiving my wellness assessment report, personalized pathway and wellness insights via Email & WhatsApp.</span>\n            </label>\n          </div>\n\n          <div id=\"liu-form-error\" class=\"liu-alert-error\" style=\"display: none;\"></div>\n\n          <div class=\"liu-btn-wrap\">\n            <button type=\"submit\" id=\"liu-btn-submit\" class=\"liu-btn-primary full-width\">\n              SEND ME MY OFFICIAL REPORT &rarr;\n            </button>\n          </div>\n        </form>\n      </div>\n    </div>\n\n    <!-- 5. FINAL REPORT SCREEN -->\n    <div id=\"liu-step-report\" class=\"liu-screen\">\n      <div class=\"liu-report-card\">\n        <div class=\"liu-badge\">OFFICIAL WELLBEING RESULT</div>\n        <h1 class=\"liu-report-heading\">LIFEITUP HOLISTIC WELLNESS SNAPSHOT</h1>\n        <p class=\"liu-report-sub\">Your Personalised Wellness Report & Pathway</p>\n\n        <div class=\"liu-score-hero\">\n          <div class=\"liu-score-label\">HOLISTIC WELLBEING SCORE</div>\n          <div class=\"liu-score-value\">\n            <span id=\"liu-final-score\">38</span> <span class=\"liu-score-max\">/ 48</span>\n          </div>\n          <div style=\"margin-top: 14px;\">\n            <span id=\"liu-zone-badge\" class=\"liu-status-pill\">🟢 STATUS: STABLE</span>\n          </div>\n        </div>\n\n        <div class=\"liu-report-section highlight-box\">\n          <h3 id=\"liu-band-title\" class=\"liu-section-title\">YOU HAVE A FOUNDATION. NOW FIND THE GAP.</h3>\n          <p id=\"liu-band-headline\" class=\"liu-section-text\"></p>\n          <p id=\"liu-band-reassurance\" class=\"liu-section-muted\"></p>\n        </div>\n\n        <div class=\"liu-report-section dark-card\">\n          <h3 class=\"liu-section-title green-accent\">🎯 YOUR FIRST STRATEGIC MOVE</h3>\n          <p id=\"liu-move-rule\" style=\"font-weight: 700; margin-bottom: 6px; color: #f8fafc;\"></p>\n          <p id=\"liu-move-advice\" class=\"liu-section-text\"></p>\n        </div>\n\n        <div class=\"liu-report-section dark-card\">\n          <h3 class=\"liu-section-title green-accent\">📋 YOUR PERSONALISED PATHWAY</h3>\n          <div id=\"liu-pathway-steps\" class=\"liu-pathway-flow\"></div>\n          <p id=\"liu-pathway-desc\" class=\"liu-section-muted\" style=\"margin-top: 8px;\"></p>\n        </div>\n\n        <div class=\"liu-success-banner\">\n          📩 <strong>Check Your Inbox & WhatsApp!</strong><br>\n          Your official Assessment PDF Report has been dispatched to your email address and WhatsApp number.\n        </div>\n\n        <div class=\"liu-btn-wrap\" style=\"margin-top: 24px;\">\n          <button type=\"button\" class=\"liu-btn-outline\" onclick=\"liuResetQuiz()\">\n            🔄 Retake Assessment\n          </button>\n        </div>\n      </div>\n    </div>\n\n  </div>\n</div>\n\n<!-- =========================================================================\n     LUXURY EMERALD DARK CSS STYLING\n     ========================================================================= -->\n<style>\n  #lifeitup-wellness-app {\n    font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;\n    background-color: #04100b;\n    color: #ecfdf5;\n    padding: 30px 16px;\n    box-sizing: border-box;\n    width: 100%;\n    min-height: 700px;\n  }\n  #lifeitup-wellness-app * {\n    box-sizing: border-box;\n  }\n  .liu-container {\n    max-width: 680px;\n    margin: 0 auto;\n  }\n  .liu-screen {\n    display: none;\n    animation: liuFadeIn 0.35s ease forwards;\n  }\n  .liu-screen.active {\n    display: block;\n  }\n  @keyframes liuFadeIn {\n    from { opacity: 0; transform: translateY(8px); }\n    to { opacity: 1; transform: translateY(0); }\n  }\n\n  /* Badges & Titles */\n  .liu-badge {\n    display: inline-block;\n    font-size: 11px;\n    letter-spacing: 1.5px;\n    font-weight: 700;\n    text-transform: uppercase;\n    color: #34d399;\n    background: rgba(16, 185, 129, 0.12);\n    border: 1px solid rgba(52, 211, 153, 0.25);\n    padding: 6px 14px;\n    border-radius: 9999px;\n    margin-bottom: 16px;\n  }\n  .liu-hero-title {\n    font-size: 32px;\n    font-weight: 800;\n    line-height: 1.25;\n    margin: 0 0 16px 0;\n    color: #ffffff;\n    letter-spacing: -0.5px;\n  }\n  .liu-highlight {\n    color: #34d399;\n    text-shadow: 0 0 24px rgba(52, 211, 153, 0.3);\n  }\n  .liu-hero-sub {\n    font-size: 16px;\n    line-height: 1.6;\n    color: #94a3b8;\n    margin-bottom: 28px;\n  }\n\n  /* Pillars Grid */\n  .liu-pillars-grid {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));\n    gap: 10px;\n    margin-bottom: 32px;\n  }\n  .liu-pillar-chip {\n    background: #092117;\n    border: 1px solid rgba(52, 211, 153, 0.18);\n    padding: 12px 14px;\n    border-radius: 10px;\n    font-size: 13px;\n    font-weight: 600;\n    color: #a7f3d0;\n  }\n\n  /* Buttons */\n  .liu-btn-wrap {\n    text-align: center;\n    margin-top: 24px;\n  }\n  .liu-btn-primary {\n    background: linear-gradient(135deg, #10b981 0%, #059669 100%);\n    color: #ffffff;\n    border: none;\n    padding: 15px 32px;\n    font-size: 16px;\n    font-weight: 700;\n    border-radius: 12px;\n    cursor: pointer;\n    transition: all 0.2s ease;\n    box-shadow: 0 4px 20px rgba(16, 185, 129, 0.35);\n  }\n  .liu-btn-primary:hover:not(:disabled) {\n    transform: translateY(-2px);\n    box-shadow: 0 6px 25px rgba(16, 185, 129, 0.5);\n  }\n  .liu-btn-primary:disabled {\n    opacity: 0.5;\n    cursor: not-allowed;\n  }\n  .liu-btn-primary.full-width {\n    width: 100%;\n  }\n  .liu-btn-outline {\n    background: transparent;\n    color: #94a3b8;\n    border: 1px solid rgba(255, 255, 255, 0.2);\n    padding: 12px 24px;\n    font-size: 14px;\n    font-weight: 600;\n    border-radius: 10px;\n    cursor: pointer;\n    transition: all 0.2s;\n  }\n  .liu-btn-outline:hover {\n    color: #ffffff;\n    border-color: #34d399;\n  }\n\n  /* Quiz Layout */\n  .liu-quiz-header {\n    margin-bottom: 24px;\n  }\n  .liu-progress-meta {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    margin-bottom: 10px;\n    font-size: 13px;\n    color: #94a3b8;\n  }\n  .liu-mini-badge {\n    background: rgba(52, 211, 153, 0.15);\n    color: #6ee7b7;\n    padding: 4px 10px;\n    border-radius: 6px;\n    font-weight: 600;\n    font-size: 12px;\n  }\n  .liu-progress-track {\n    width: 100%;\n    height: 6px;\n    background: #092117;\n    border-radius: 9999px;\n    overflow: hidden;\n  }\n  .liu-progress-fill {\n    height: 100%;\n    background: #10b981;\n    transition: width 0.3s ease;\n  }\n  .liu-question-box {\n    background: #092117;\n    border: 1px solid rgba(52, 211, 153, 0.25);\n    border-radius: 14px;\n    padding: 24px;\n    margin-bottom: 20px;\n  }\n  .liu-question-title {\n    font-size: 20px;\n    font-weight: 700;\n    color: #ffffff;\n    line-height: 1.45;\n    margin: 0;\n  }\n\n  /* Options */\n  .liu-options-grid {\n    display: grid;\n    grid-template-columns: 1fr;\n    gap: 12px;\n    margin-bottom: 24px;\n  }\n  .liu-option-btn {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    background: #061811;\n    border: 1.5px solid rgba(52, 211, 153, 0.2);\n    border-radius: 12px;\n    padding: 16px 20px;\n    color: #cbd5e1;\n    font-size: 15px;\n    font-weight: 600;\n    cursor: pointer;\n    text-align: left;\n    transition: all 0.2s;\n  }\n  .liu-option-btn:hover {\n    border-color: #34d399;\n    background: #0b2c1f;\n    color: #ffffff;\n  }\n  .liu-option-btn.selected {\n    border-color: #10b981;\n    background: rgba(16, 185, 129, 0.18);\n    color: #6ee7b7;\n    box-shadow: 0 0 16px rgba(16, 185, 129, 0.25);\n  }\n  .liu-nav-row {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n  }\n\n  /* Analyzing Spinner */\n  .liu-analyzing-box {\n    text-align: center;\n    padding: 60px 20px;\n  }\n  .liu-spinner {\n    width: 54px;\n    height: 54px;\n    border: 4px solid rgba(52, 211, 153, 0.2);\n    border-top-color: #10b981;\n    border-radius: 50%;\n    margin: 0 auto 24px;\n    animation: liuSpin 0.9s linear infinite;\n  }\n  @keyframes liuSpin {\n    to { transform: rotate(360deg); }\n  }\n  .liu-analyzing-title {\n    font-size: 22px;\n    font-weight: 700;\n    color: #ffffff;\n    margin: 0 0 10px 0;\n  }\n  .liu-analyzing-desc {\n    color: #94a3b8;\n    font-size: 14px;\n  }\n\n  /* Form Styling */\n  .liu-lead-box {\n    background: #092117;\n    border: 1px solid rgba(52, 211, 153, 0.25);\n    border-radius: 16px;\n    padding: 32px 28px;\n  }\n  .liu-lead-title {\n    font-size: 24px;\n    font-weight: 800;\n    color: #ffffff;\n    margin: 0 0 10px 0;\n  }\n  .liu-lead-sub {\n    font-size: 14px;\n    color: #94a3b8;\n    line-height: 1.6;\n    margin: 0 0 24px 0;\n  }\n  .liu-field-group {\n    margin-bottom: 18px;\n  }\n  .liu-label {\n    display: block;\n    font-size: 13px;\n    font-weight: 600;\n    color: #cbd5e1;\n    margin-bottom: 6px;\n  }\n  .liu-input {\n    width: 100%;\n    padding: 13px 16px;\n    background: #04100b;\n    border: 1.5px solid rgba(52, 211, 153, 0.25);\n    border-radius: 10px;\n    color: #ffffff;\n    font-size: 15px;\n    outline: none;\n    transition: border-color 0.2s;\n  }\n  .liu-input:focus {\n    border-color: #10b981;\n    box-shadow: 0 0 12px rgba(16, 185, 129, 0.2);\n  }\n  .liu-checkbox-group {\n    margin: 20px 0;\n  }\n  .liu-checkbox-label {\n    display: flex;\n    align-items: flex-start;\n    gap: 10px;\n    font-size: 12px;\n    color: #94a3b8;\n    line-height: 1.5;\n    cursor: pointer;\n  }\n  .liu-checkbox {\n    margin-top: 2px;\n    accent-color: #10b981;\n    cursor: pointer;\n  }\n  .liu-alert-error {\n    background: rgba(225, 29, 72, 0.15);\n    border: 1px solid #f43f5e;\n    color: #fecdd3;\n    padding: 12px 14px;\n    border-radius: 8px;\n    font-size: 13px;\n    margin-bottom: 16px;\n  }\n\n  /* Final Report Styling */\n  .liu-report-card {\n    background: #092117;\n    border: 1px solid rgba(52, 211, 153, 0.3);\n    border-radius: 16px;\n    padding: 32px 24px;\n  }\n  .liu-report-heading {\n    font-size: 24px;\n    font-weight: 800;\n    color: #ffffff;\n    margin: 0 0 4px 0;\n  }\n  .liu-report-sub {\n    font-size: 13px;\n    color: #94a3b8;\n    margin: 0 0 24px 0;\n  }\n  .liu-score-hero {\n    background: #051911;\n    border: 1.5px solid rgba(52, 211, 153, 0.3);\n    border-radius: 14px;\n    padding: 24px;\n    text-align: center;\n    margin-bottom: 24px;\n  }\n  .liu-score-label {\n    font-size: 11px;\n    letter-spacing: 1.5px;\n    font-weight: 700;\n    color: #a7f3d0;\n    margin-bottom: 8px;\n  }\n  .liu-score-value {\n    font-size: 48px;\n    font-weight: 800;\n    color: #ffffff;\n    line-height: 1;\n  }\n  .liu-score-max {\n    font-size: 22px;\n    font-weight: 600;\n    color: #34d399;\n  }\n  .liu-status-pill {\n    display: inline-block;\n    padding: 6px 16px;\n    border-radius: 9999px;\n    font-size: 13px;\n    font-weight: 700;\n    background: #064e3b;\n    color: #6ee7b7;\n    border: 1px solid rgba(52, 211, 153, 0.4);\n  }\n  .liu-report-section {\n    padding: 18px 20px;\n    border-radius: 12px;\n    margin-bottom: 18px;\n  }\n  .liu-report-section.highlight-box {\n    background: rgba(16, 185, 129, 0.1);\n    border-left: 4px solid #10b981;\n  }\n  .liu-report-section.dark-card {\n    background: #061811;\n    border: 1px solid rgba(52, 211, 153, 0.18);\n  }\n  .liu-section-title {\n    font-size: 14px;\n    font-weight: 700;\n    color: #f1f5f9;\n    margin: 0 0 8px 0;\n    letter-spacing: 0.5px;\n  }\n  .liu-section-title.green-accent {\n    color: #34d399;\n    font-size: 12px;\n    letter-spacing: 1px;\n    text-transform: uppercase;\n  }\n  .liu-section-text {\n    font-size: 14px;\n    line-height: 1.6;\n    color: #cbd5e1;\n    margin: 0;\n  }\n  .liu-section-muted {\n    font-size: 13px;\n    line-height: 1.5;\n    color: #94a3b8;\n    margin: 8px 0 0 0;\n    font-style: italic;\n  }\n  .liu-pathway-flow {\n    color: #6ee7b7;\n    font-weight: 800;\n    font-size: 15px;\n    letter-spacing: 1px;\n  }\n  .liu-success-banner {\n    background: rgba(5, 150, 105, 0.2);\n    border: 1px solid #10b981;\n    padding: 16px;\n    border-radius: 10px;\n    font-size: 13px;\n    color: #d1fae5;\n    line-height: 1.5;\n    text-align: center;\n  }\n</style>\n\n<!-- =========================================================================\n     JAVASCRIPT LOGIC & API DISPATCH\n     ========================================================================= -->\n<script>\n(function() {\n  // Backend API URL (Default: Vercel Production)\n  var BACKEND_API_URL = \"https://lifeitup.vercel.app/api/leads\";\n\n  var questions = [\n    { id: 1, pillar: \"Pillar 1 — Soul / Purpose\", text: \"My daily life is connected to a clear, bigger purpose\" },\n    { id: 2, pillar: \"Pillar 1 — Soul / Purpose\", text: \"The way I spend my time reflects, what truly matters to me.\" },\n    { id: 3, pillar: \"Pillar 2 — Mind / Inner Calm\", text: \"I can stay calm and think clearly when life becomes stressful.\" },\n    { id: 4, pillar: \"Pillar 2 — Mind / Inner Calm\", text: \"I can focus on that matters, without constant distractions\" },\n    { id: 5, pillar: \"Pillar 3 — Body / Energy\", text: \"I feel energetic throughout the day\" },\n    { id: 6, pillar: \"Pillar 3 — Body / Energy\", text: \"My everyday habits—sleep, movement, food - nutrition & recovery are in ideal zone.\" },\n    { id: 7, pillar: \"Pillar 4 — Career / Growth\", text: \"I have clarity & confidence in making important career decisions\" },\n    { id: 8, pillar: \"Pillar 4 — Career / Growth\", text: \"I feel that I am learning, moving, growing in an area that matters to me.\" },\n    { id: 9, pillar: \"Pillar 5 — Environment / Connection\", text: \"My physical and digital surroundings help me feel organised, calm and in control.\" },\n    { id: 10, pillar: \"Pillar 5 — Environment / Connection\", text: \"The people closest to me generally support my wellbeing, growth and sense of belonging.\" },\n    { id: 11, pillar: \"Pillar 6 — Contribution / Impact\", text: \"I feel that what I do makes a positive difference to other people.\" },\n    { id: 12, pillar: \"Pillar 6 — Contribution / Impact\", text: \"I regularly make time to help, support or uplift others.\" }\n  ];\n\n  var options = [\n    { label: \"Never\", value: 1 },\n    { label: \"Sometimes\", value: 2 },\n    { label: \"Often\", value: 3 },\n    { label: \"Always\", value: 4 }\n  ];\n\n  var currentIndex = 0;\n  var answers = {};\n  var sessionId = \"wp_\" + Math.random().toString(36).substring(2, 10) + \"_\" + Date.now();\n\n  function showScreen(id) {\n    document.querySelectorAll(\".liu-screen\").forEach(function(el) { el.classList.remove(\"active\"); });\n    var target = document.getElementById(id);\n    if (target) target.classList.add(\"active\");\n    var container = document.getElementById(\"lifeitup-wellness-app\");\n    if (container) container.scrollIntoView({ behavior: \"smooth\" });\n  }\n\n  window.liuStartQuiz = function() {\n    currentIndex = 0;\n    answers = {};\n    renderQuestion();\n    showScreen(\"liu-step-quiz\");\n  };\n\n  function renderQuestion() {\n    var q = questions[currentIndex];\n    document.getElementById(\"liu-q-counter\").textContent = \"Question \" + (currentIndex + 1) + \" of 12\";\n    document.getElementById(\"liu-pillar-badge\").textContent = q.pillar;\n    document.getElementById(\"liu-question-text\").textContent = q.text;\n\n    var pct = ((currentIndex + 1) / 12) * 100;\n    document.getElementById(\"liu-progress-bar\").style.width = pct + \"%\";\n\n    var optionsContainer = document.getElementById(\"liu-options-container\");\n    optionsContainer.innerHTML = \"\";\n\n    var currentAns = answers[q.id];\n\n    options.forEach(function(opt) {\n      var btn = document.createElement(\"button\");\n      btn.type = \"button\";\n      btn.className = \"liu-option-btn\" + (currentAns === opt.value ? \" selected\" : \"\");\n      btn.innerHTML = \"<span>\" + opt.label + \"</span><span>\" + (currentAns === opt.value ? \"✓\" : \"\") + \"</span>\";\n      btn.onclick = function() {\n        answers[q.id] = opt.value;\n        renderQuestion();\n        document.getElementById(\"liu-btn-next\").disabled = false;\n      };\n      optionsContainer.appendChild(btn);\n    });\n\n    document.getElementById(\"liu-btn-back\").style.visibility = (currentIndex === 0) ? \"hidden\" : \"visible\";\n    document.getElementById(\"liu-btn-next\").disabled = !answers[q.id];\n  }\n\n  window.liuPrevQuestion = function() {\n    if (currentIndex > 0) {\n      currentIndex--;\n      renderQuestion();\n    }\n  };\n\n  window.liuNextQuestion = function() {\n    var q = questions[currentIndex];\n    if (!answers[q.id]) return;\n\n    if (currentIndex < questions.length - 1) {\n      currentIndex++;\n      renderQuestion();\n    } else {\n      // Finished 12 questions -> Analyze screen\n      showScreen(\"liu-step-analyzing\");\n      setTimeout(function() {\n        showScreen(\"liu-step-lead\");\n      }, 1400);\n    }\n  };\n\n  window.liuHandleFormSubmit = async function(e) {\n    e.preventDefault();\n    var errBox = document.getElementById(\"liu-form-error\");\n    errBox.style.display = \"none\";\n\n    var name = document.getElementById(\"liu-name\").value.trim();\n    var institution = document.getElementById(\"liu-institution\").value.trim();\n    var phone = document.getElementById(\"liu-phone\").value.trim();\n    var email = document.getElementById(\"liu-email\").value.trim();\n    var consent = document.getElementById(\"liu-consent\").checked;\n\n    if (!name || !email || !phone) {\n      errBox.textContent = \"Please fill in all required fields.\";\n      errBox.style.display = \"block\";\n      return;\n    }\n\n    var submitBtn = document.getElementById(\"liu-btn-submit\");\n    submitBtn.disabled = true;\n    submitBtn.textContent = \"GENERATING YOUR REPORT...\";\n\n    var payload = {\n      sessionId: sessionId,\n      fullName: name,\n      organization: institution,\n      institution: institution,\n      email: email,\n      mobile: phone,\n      consent: consent,\n      answers: answers\n    };\n\n    try {\n      var res = await fetch(BACKEND_API_URL, {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify(payload)\n      });\n      var data = await res.json();\n\n      if (!res.ok) {\n        throw new Error(data.error || \"Failed to submit assessment.\");\n      }\n\n      // Display Final Report Screen\n      renderReportScreen(data);\n      showScreen(\"liu-step-report\");\n\n    } catch (err) {\n      errBox.textContent = \"Error: \" + err.message + \". Please try again.\";\n      errBox.style.display = \"block\";\n      submitBtn.disabled = false;\n      submitBtn.textContent = \"SEND ME MY OFFICIAL REPORT \\u2192\";\n    }\n  };\n\n  function renderReportScreen(data) {\n    var score = (data.report && data.report.score) || 36;\n    var band = (data.report && data.report.scoreBand) || {};\n\n    document.getElementById(\"liu-final-score\").textContent = score;\n    document.getElementById(\"liu-zone-badge\").textContent = (band.emoji || \"✨\") + \" STATUS: \" + (band.zone || \"STABLE\");\n    document.getElementById(\"liu-band-title\").textContent = band.title || \"YOUR ASSESSMENT RESULT\";\n    document.getElementById(\"liu-band-headline\").textContent = band.headline || \"\";\n    document.getElementById(\"liu-band-reassurance\").textContent = band.reassurance || \"\";\n    document.getElementById(\"liu-move-rule\").textContent = band.firstMoveRule || \"\";\n    document.getElementById(\"liu-move-advice\").textContent = band.firstMoveAdvice || \"\";\n    document.getElementById(\"liu-pathway-steps\").innerHTML = (band.pathwaySteps || [\"RESET\", \"BUILD\", \"SUSTAIN\"]).join(\" &rarr; \");\n    document.getElementById(\"liu-pathway-desc\").textContent = band.pathwayDescription || \"\";\n  }\n\n  window.liuResetQuiz = function() {\n    sessionId = \"wp_\" + Math.random().toString(36).substring(2, 10) + \"_\" + Date.now();\n    currentIndex = 0;\n    answers = {};\n    document.getElementById(\"liu-lead-form\").reset();\n    showScreen(\"liu-step-intro\");\n  };\n\n})();\n</script>\n"

            {
              "id": "liu_widget_ot26b3j",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "<!-- =========================================================================\n     LIFEITUP 2-MINUTE HOLISTIC WELLBEING CHECK — EXACT ORIGINAL ROYAL BOTANICAL DESIGN\n     100% Native Code for WordPress Elementor / Gutenberg\n     Includes: Exact Fonts, Emblem Logo, Royal Option Cards, Animations & Backend API\n     ========================================================================= -->\n\n<div id=\"lifeitup-app-root\">\n  <div class=\"liu-shell\">\n\n    <!-- TOP BRANDING (Exact Original Logo & Emblem) -->\n    <header class=\"liu-brand-header\">\n      <img src=\"https://lifeitup.vercel.app/logo-emblem.png\" alt=\"LifeITUp Emblem\" class=\"liu-emblem\" />\n      <div class=\"liu-brand-title-wrap\">\n        <span class=\"liu-brand-dash\"></span>\n        <span class=\"liu-brand-name\">LifeITup</span>\n        <span class=\"liu-brand-dash\"></span>\n      </div>\n      <div class=\"liu-brand-tagline\">Empowering Your Holistic Success</div>\n    </header>\n\n    <!-- 1. INTRO SCREEN (Exact Original) -->\n    <div id=\"liu-screen-intro\" class=\"liu-screen active\">\n      <div class=\"liu-center-wrap\">\n        <div class=\"liu-prestige-pill\">\n          <svg class=\"liu-icon-clock\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><polyline points=\"12 6 12 12 16 14\"></polyline></svg>\n          <span>2-MINUTE FULL WELLBEING CHECK</span>\n        </div>\n\n        <h1 class=\"liu-hero-h1\">\n          Holistic Wellness <br>\n          <span class=\"liu-text-emerald\">Assessment</span>\n        </h1>\n\n        <p class=\"liu-hero-desc\">Discover your Wellbeing Score across 6 dimensions of life.</p>\n        <div class=\"liu-meta-chips\">\n          <span>12 questions</span>\n          <span class=\"liu-dot\">•</span>\n          <span>2 minutes</span>\n          <span class=\"liu-dot\">•</span>\n          <span class=\"liu-meta-highlight\">Personalised Report</span>\n        </div>\n\n        <div class=\"liu-glass-card liu-before-card\">\n          <div class=\"liu-before-header\">\n            <svg class=\"liu-sparkle\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 2l2.4 7.2L22 12l-7.6 2.8L12 22l-2.4-7.2L2 12l7.6-2.8L12 2z\"/></svg>\n            <span>Before you begin…</span>\n          </div>\n          <ul class=\"liu-before-list\">\n            <li>\n              <svg class=\"liu-check-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\"><polyline points=\"20 6 9 17 4 12\"></polyline></svg>\n              <span>Think about your life over the past 30 days—not your ideal self.</span>\n            </li>\n            <li>\n              <svg class=\"liu-check-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\"><polyline points=\"20 6 9 17 4 12\"></polyline></svg>\n              <span>There are no right or wrong answers.</span>\n            </li>\n            <li>\n              <svg class=\"liu-check-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\"><polyline points=\"20 6 9 17 4 12\"></polyline></svg>\n              <span>Choose the response that most honestly reflects your experience.</span>\n            </li>\n          </ul>\n        </div>\n\n        <div class=\"liu-cta-wrap\">\n          <button type=\"button\" class=\"liu-btn-royal\" onclick=\"liuStartAssessment()\">\n            <span>I'M READY</span>\n            <svg class=\"liu-arrow-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line><polyline points=\"12 5 19 12 12 19\"></polyline></svg>\n          </button>\n          <div class=\"liu-subtext-trust\">\n            <svg class=\"liu-shield\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"></path></svg>\n            <span>Private & confidential · Results generated instantly</span>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- 2. QUIZ SCREEN (Exact Original Royal Option Cards) -->\n    <div id=\"liu-screen-quiz\" class=\"liu-screen\">\n      <div class=\"liu-quiz-container\">\n        <!-- Progress Counter -->\n        <div class=\"liu-progress-header\">\n          <span id=\"liu-q-counter\" class=\"liu-q-counter-text\">Question 1 of 12</span>\n          <span id=\"liu-q-pct\" class=\"liu-q-pct-text\">8% Complete</span>\n        </div>\n        <div class=\"liu-progress-track\">\n          <div id=\"liu-progress-bar\" class=\"liu-progress-bar-fill\" style=\"width: 8.33%;\"></div>\n        </div>\n\n        <!-- Pillar Badge -->\n        <div class=\"liu-pillar-pill-wrap\">\n          <span id=\"liu-pillar-pill\" class=\"liu-pillar-pill\">\n            <span id=\"liu-pillar-icon-symbol\">🌟</span>\n            <span id=\"liu-pillar-text\">Pillar 1 — Soul / Purpose</span>\n          </span>\n        </div>\n\n        <!-- Question Text -->\n        <h2 id=\"liu-question-text\" class=\"liu-question-h2\">\n          My daily life is connected to a clear, bigger purpose\n        </h2>\n\n        <!-- Answer Options -->\n        <div class=\"liu-options-wrapper\" id=\"liu-options-list\">\n          <!-- Rendered via JS -->\n        </div>\n\n        <!-- Navigation Buttons -->\n        <div class=\"liu-nav-bar\">\n          <button type=\"button\" id=\"liu-btn-back\" class=\"liu-btn-nav-outline\" onclick=\"liuPrevQuestion()\" style=\"visibility: hidden;\">\n            <svg class=\"liu-arrow-left\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><line x1=\"19\" y1=\"12\" x2=\"5\" y2=\"12\"></line><polyline points=\"12 19 5 12 12 5\"></polyline></svg>\n            <span>Back</span>\n          </button>\n          <button type=\"button\" id=\"liu-btn-next\" class=\"liu-btn-royal liu-btn-compact\" onclick=\"liuNextQuestion()\" disabled>\n            <span id=\"liu-next-btn-text\">Next</span>\n            <svg class=\"liu-arrow-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line><polyline points=\"12 5 19 12 12 19\"></polyline></svg>\n          </button>\n        </div>\n      </div>\n    </div>\n\n    <!-- 3. ANALYZING SCREEN -->\n    <div id=\"liu-screen-analyzing\" class=\"liu-screen\">\n      <div class=\"liu-center-wrap\" style=\"padding: 40px 10px;\">\n        <div class=\"liu-emerald-spinner\"></div>\n        <h2 class=\"liu-analyzing-h2\">Analyzing Your 6 Wellbeing Dimensions...</h2>\n        <p class=\"liu-analyzing-sub\">Aligning responses with WHO multidimensional wellbeing guidelines.</p>\n      </div>\n    </div>\n\n    <!-- 4. LEAD CAPTURE SCREEN (Exact Original Form) -->\n    <div id=\"liu-screen-lead\" class=\"liu-screen\">\n      <div class=\"liu-lead-card liu-glass-card\">\n        <!-- Teaser Pill -->\n        <div class=\"liu-lead-pill-wrap\">\n          <div class=\"liu-teaser-pill\">\n            <svg class=\"liu-lock\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><rect x=\"3\" y=\"11\" width=\"18\" height=\"11\" rx=\"2\" ry=\"2\"></rect><path d=\"M7 11V7a5 5 0 0 1 10 0v4\"></path></svg>\n            <span>Status: <strong id=\"liu-teaser-zone\">STABLE</strong> (<span id=\"liu-teaser-score\">36</span>/48) &bull; Report Ready</span>\n          </div>\n        </div>\n\n        <h1 class=\"liu-lead-h1\">Unlock Your Full Report</h1>\n        <p class=\"liu-lead-desc\">\n          Your preliminary <strong id=\"liu-lead-desc-zone\">Holistic</strong> score is ready. Enter your details below to receive your complete 6-pillar breakdown & personalized action pathway.\n        </p>\n\n        <form id=\"liu-form-element\" onsubmit=\"liuSubmitForm(event)\">\n          <div class=\"liu-form-row\">\n            <label class=\"liu-form-label\">Full Name <span class=\"liu-req\">*</span></label>\n            <input type=\"text\" id=\"liu-input-name\" class=\"liu-form-input\" placeholder=\"e.g. Rahul Sharma\" required />\n            <div id=\"liu-err-name\" class=\"liu-field-err\"></div>\n          </div>\n\n          <div class=\"liu-form-row\">\n            <label class=\"liu-form-label\">Institution / Organisation Name <span class=\"liu-req\">*</span></label>\n            <input type=\"text\" id=\"liu-input-institution\" class=\"liu-form-input\" placeholder=\"e.g. Delhi University / St. Xavier's\" required />\n            <div id=\"liu-err-institution\" class=\"liu-field-err\"></div>\n          </div>\n\n          <div class=\"liu-form-row\">\n            <label class=\"liu-form-label\">Mobile Number (WhatsApp) <span class=\"liu-req\">*</span></label>\n            <input type=\"tel\" id=\"liu-input-phone\" class=\"liu-form-input\" placeholder=\"e.g. 9876543210\" required />\n            <div id=\"liu-err-phone\" class=\"liu-field-err\"></div>\n          </div>\n\n          <div class=\"liu-form-row\">\n            <label class=\"liu-form-label\">Email Address <span class=\"liu-req\">*</span></label>\n            <input type=\"email\" id=\"liu-input-email\" class=\"liu-form-input\" placeholder=\"e.g. rahul@example.com\" required />\n            <div id=\"liu-err-email\" class=\"liu-field-err\"></div>\n          </div>\n\n          <div class=\"liu-form-consent\">\n            <label class=\"liu-consent-lbl\">\n              <input type=\"checkbox\" id=\"liu-input-consent\" class=\"liu-checkbox-native\" checked required />\n              <span>I agree to receive my assessment report and wellbeing insights via Email & WhatsApp.</span>\n            </label>\n            <div id=\"liu-err-consent\" class=\"liu-field-err\"></div>\n          </div>\n\n          <div id=\"liu-global-error\" class=\"liu-alert-danger\" style=\"display: none;\"></div>\n\n          <div class=\"liu-cta-wrap\" style=\"margin-top: 20px;\">\n            <button type=\"submit\" id=\"liu-btn-submit-lead\" class=\"liu-btn-royal liu-btn-full\">\n              <span>SEND ME MY OFFICIAL REPORT</span>\n              <svg class=\"liu-arrow-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line><polyline points=\"12 5 19 12 12 19\"></polyline></svg>\n            </button>\n          </div>\n        </form>\n      </div>\n    </div>\n\n    <!-- 5. FINAL REPORT SCREEN (Exact Luxury Report View) -->\n    <div id=\"liu-screen-report\" class=\"liu-screen\">\n      <div class=\"liu-report-card-royal liu-glass-card\">\n        <div class=\"liu-prestige-pill\">\n          <span>OFFICIAL WELLBEING RESULT</span>\n        </div>\n        <h1 class=\"liu-report-h1\">LIFEITUP HOLISTIC WELLNESS SNAPSHOT</h1>\n        <p class=\"liu-report-h2\">Your Personalised Wellness Report & Pathway</p>\n\n        <!-- Score Hero -->\n        <div class=\"liu-score-box\">\n          <div class=\"liu-score-tag\">HOLISTIC WELLBEING SCORE</div>\n          <div class=\"liu-score-digits\">\n            <span id=\"liu-report-score-num\">38</span>\n            <span class=\"liu-score-denom\">/ 48</span>\n          </div>\n          <div style=\"margin-top: 12px;\">\n            <span id=\"liu-report-zone-badge\" class=\"liu-zone-badge-pill\">🟢 STATUS: STABLE</span>\n          </div>\n        </div>\n\n        <!-- Section: Title & Headline -->\n        <div class=\"liu-report-block liu-block-highlight\">\n          <h3 id=\"liu-report-band-title\" class=\"liu-block-title\">YOU HAVE A FOUNDATION. NOW FIND THE GAP.</h3>\n          <p id=\"liu-report-band-headline\" class=\"liu-block-p\"></p>\n          <p id=\"liu-report-band-reassurance\" class=\"liu-block-muted\"></p>\n        </div>\n\n        <!-- Section: First Move -->\n        <div class=\"liu-report-block liu-block-white\">\n          <h4 class=\"liu-section-tag\">🎯 YOUR FIRST STRATEGIC MOVE</h4>\n          <p id=\"liu-report-move-rule\" class=\"liu-move-rule-text\"></p>\n          <p id=\"liu-report-move-advice\" class=\"liu-block-p\"></p>\n        </div>\n\n        <!-- Section: Personalised Pathway -->\n        <div class=\"liu-report-block liu-block-white\">\n          <h4 class=\"liu-section-tag\">📋 YOUR PERSONALISED PATHWAY</h4>\n          <div id=\"liu-report-pathway-steps\" class=\"liu-pathway-chain\"></div>\n          <p id=\"liu-report-pathway-desc\" class=\"liu-block-muted\" style=\"margin-top: 6px;\"></p>\n        </div>\n\n        <!-- Success Dispatch Notice -->\n        <div class=\"liu-dispatched-box\">\n          <div class=\"liu-dispatch-icon\">📩</div>\n          <div>\n            <strong>Check Your Inbox & WhatsApp!</strong><br>\n            Your official high-resolution PDF Assessment Report has been dispatched to your email and WhatsApp number.\n          </div>\n        </div>\n\n        <div class=\"liu-cta-wrap\" style=\"margin-top: 24px;\">\n          <button type=\"button\" class=\"liu-btn-nav-outline\" onclick=\"liuRestartAssessment()\">\n            <span>🔄 Retake Assessment</span>\n          </button>\n        </div>\n      </div>\n    </div>\n\n    <!-- FOOTER -->\n    <footer class=\"liu-brand-footer\">\n      <p>&copy; LifeITup &bull; <a href=\"https://lifeitupworldwide.com\" target=\"_blank\" rel=\"noopener noreferrer\">www.lifeitupworldwide.com</a></p>\n    </footer>\n\n  </div>\n</div>\n\n<!-- =========================================================================\n     EXACT ROYAL BOTANICAL CREAM CSS (100% Theme-Isolation Proof)\n     ========================================================================= -->\n<style>\n  @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap');\n\n  /* Root Container Isolation */\n  #lifeitup-app-root {\n    all: initial;\n    display: block;\n    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;\n    background-color: #FAF6EE !important;\n    color: #1A2E24 !important;\n    padding: 30px 16px 50px 16px !important;\n    box-sizing: border-box !important;\n    width: 100% !important;\n    min-height: 100vh !important;\n    letter-spacing: -0.01em !important;\n    -webkit-font-smoothing: antialiased !important;\n    text-rendering: optimizeLegibility !important;\n  }\n  #lifeitup-app-root * {\n    box-sizing: border-box !important;\n    font-family: inherit !important;\n  }\n  .liu-shell {\n    max-width: 620px !important;\n    margin: 0 auto !important;\n  }\n  .liu-screen {\n    display: none !important;\n    animation: liuFadeIn 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards !important;\n  }\n  .liu-screen.active {\n    display: block !important;\n  }\n  @keyframes liuFadeIn {\n    from { opacity: 0; transform: translateY(8px); }\n    to { opacity: 1; transform: translateY(0); }\n  }\n\n  /* Header Branding */\n  .liu-brand-header {\n    display: flex !important;\n    flex-direction: column !important;\n    align-items: center !important;\n    text-align: center !important;\n    margin-bottom: 24px !important;\n  }\n  .liu-emblem {\n    width: 58px !important;\n    height: 58px !important;\n    object-fit: contain !important;\n    margin-bottom: 8px !important;\n    filter: drop-shadow(0 2px 8px rgba(4, 120, 87, 0.18)) !important;\n  }\n  .liu-brand-title-wrap {\n    display: flex !important;\n    align-items: center !important;\n    justify-content: center !important;\n    gap: 12px !important;\n  }\n  .liu-brand-dash {\n    width: 16px !important;\n    height: 2px !important;\n    background-color: #059669 !important;\n    display: inline-block !important;\n  }\n  .liu-brand-name {\n    font-size: 16px !important;\n    font-weight: 900 !important;\n    letter-spacing: 0.28em !important;\n    color: #0A2618 !important;\n    text-transform: uppercase !important;\n  }\n  .liu-brand-tagline {\n    font-size: 11px !important;\n    font-weight: 600 !important;\n    color: #065F46 !important;\n    letter-spacing: 0.08em !important;\n    margin-top: 4px !important;\n  }\n\n  /* Center Container */\n  .liu-center-wrap {\n    display: flex !important;\n    flex-direction: column !important;\n    align-items: center !important;\n    text-align: center !important;\n  }\n\n  /* Prestige Pill Badge */\n  .liu-prestige-pill {\n    display: inline-flex !important;\n    align-items: center !important;\n    gap: 8px !important;\n    padding: 6px 16px !important;\n    border-radius: 9999px !important;\n    font-size: 11px !important;\n    font-weight: 800 !important;\n    letter-spacing: 0.08em !important;\n    text-transform: uppercase !important;\n    background: #EBF5EE !important;\n    border: 1px solid #C2E3CD !important;\n    color: #065F46 !important;\n    margin-bottom: 14px !important;\n  }\n  .liu-icon-clock {\n    width: 14px !important;\n    height: 14px !important;\n    color: #047857 !important;\n  }\n\n  /* Hero Typography */\n  .liu-hero-h1 {\n    font-size: 34px !important;\n    font-weight: 800 !important;\n    color: #0A2618 !important;\n    line-height: 1.18 !important;\n    letter-spacing: -0.025em !important;\n    margin: 0 0 10px 0 !important;\n  }\n  .liu-text-emerald {\n    color: #047857 !important;\n  }\n  .liu-hero-desc {\n    font-size: 14px !important;\n    font-weight: 500 !important;\n    color: #2E4337 !important;\n    margin: 0 0 12px 0 !important;\n  }\n  .liu-meta-chips {\n    display: inline-flex !important;\n    align-items: center !important;\n    gap: 10px !important;\n    background: rgba(255, 255, 255, 0.85) !important;\n    border: 1px solid #E5DFD3 !important;\n    padding: 6px 14px !important;\n    border-radius: 9999px !important;\n    font-size: 12px !important;\n    color: #2E4337 !important;\n    font-weight: 500 !important;\n    margin-bottom: 22px !important;\n  }\n  .liu-dot {\n    opacity: 0.4 !important;\n  }\n  .liu-meta-highlight {\n    color: #047857 !important;\n    font-weight: 700 !important;\n  }\n\n  /* Royal Glass Card */\n  .liu-glass-card {\n    background: rgba(255, 255, 255, 0.95) !important;\n    border: 1px solid #EBE5D8 !important;\n    border-radius: 20px !important;\n    box-shadow: 0 16px 36px -12px rgba(26, 46, 36, 0.08), 0 2px 6px 0 rgba(0, 0, 0, 0.02) !important;\n  }\n  .liu-before-card {\n    width: 100% !important;\n    max-width: 520px !important;\n    padding: 20px 22px !important;\n    text-align: left !important;\n    margin-bottom: 24px !important;\n  }\n  .liu-before-header {\n    display: flex !important;\n    align-items: center !important;\n    gap: 8px !important;\n    font-size: 11px !important;\n    font-weight: 800 !important;\n    color: #065F46 !important;\n    text-transform: uppercase !important;\n    letter-spacing: 0.08em !important;\n    margin-bottom: 12px !important;\n  }\n  .liu-sparkle {\n    width: 16px !important;\n    height: 16px !important;\n    color: #d97706 !important;\n  }\n  .liu-before-list {\n    list-style: none !important;\n    padding: 0 !important;\n    margin: 0 !important;\n  }\n  .liu-before-list li {\n    display: flex !important;\n    align-items: flex-start !important;\n    gap: 10px !important;\n    font-size: 13px !important;\n    color: #1A2E24 !important;\n    font-weight: 500 !important;\n    margin-bottom: 10px !important;\n    line-height: 1.45 !important;\n  }\n  .liu-before-list li:last-child {\n    margin-bottom: 0 !important;\n  }\n  .liu-check-icon {\n    width: 16px !important;\n    height: 16px !important;\n    color: #059669 !important;\n    flex-shrink: 0 !important;\n    margin-top: 2px !important;\n  }\n\n  /* Royal Gold & Forest Button */\n  .liu-cta-wrap {\n    display: flex !important;\n    flex-direction: column !important;\n    align-items: center !important;\n    width: 100% !important;\n  }\n  .liu-btn-royal {\n    display: inline-flex !important;\n    align-items: center !important;\n    justify-content: center !important;\n    gap: 10px !important;\n    background: linear-gradient(135deg, #064E3B 0%, #047857 55%, #059669 100%) !important;\n    color: #FFFFFF !important;\n    border: none !important;\n    border-radius: 9999px !important;\n    padding: 14px 44px !important;\n    font-size: 15px !important;\n    font-weight: 800 !important;\n    letter-spacing: 0.03em !important;\n    cursor: pointer !important;\n    box-shadow: 0 4px 18px rgba(4, 120, 87, 0.28) !important;\n    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1) !important;\n    outline: none !important;\n  }\n  .liu-btn-royal:hover:not(:disabled) {\n    transform: translateY(-2px) !important;\n    box-shadow: 0 8px 24px rgba(4, 120, 87, 0.42) !important;\n    color: #FFFFFF !important;\n  }\n  .liu-btn-royal:disabled {\n    background: #EBE5D8 !important;\n    color: #9A8F7E !important;\n    cursor: not-allowed !important;\n    box-shadow: none !important;\n    opacity: 0.7 !important;\n  }\n  .liu-btn-compact {\n    padding: 10px 28px !important;\n    font-size: 14px !important;\n  }\n  .liu-btn-full {\n    width: 100% !important;\n    padding: 15px 24px !important;\n  }\n  .liu-arrow-icon {\n    width: 16px !important;\n    height: 16px !important;\n    transition: transform 0.2s !important;\n  }\n  .liu-btn-royal:hover .liu-arrow-icon {\n    transform: translateX(4px) !important;\n  }\n  .liu-btn-nav-outline {\n    display: inline-flex !important;\n    align-items: center !important;\n    gap: 6px !important;\n    background: #FFFFFF !important;\n    border: 1px solid #DDD5C5 !important;\n    color: #2E4337 !important;\n    padding: 10px 20px !important;\n    border-radius: 9999px !important;\n    font-size: 13px !important;\n    font-weight: 700 !important;\n    cursor: pointer !important;\n    transition: all 0.2s !important;\n  }\n  .liu-btn-nav-outline:hover {\n    background: #F3EFE6 !important;\n    color: #0A2618 !important;\n    border-color: #047857 !important;\n  }\n  .liu-arrow-left {\n 